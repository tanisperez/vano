# Maintainer: Estanislao Pérez Nartallo <tanisperez@gmail.com>
#
# Template of the AUR package `vano-bin`. `pkgver` and the checksum are filled in for each
# release (`updpkgsums`, or by CI once the AUR account exists, see packaging/aur/README.md).
pkgname=vano-bin
pkgver=0.1.0
pkgrel=1
pkgdesc='See what fills your disk and clear it safely'
arch=('x86_64')
url='https://vano.tanis.codes'
license=('Apache-2.0')
depends=('libxkbcommon' 'libxkbcommon-x11' 'libxcb' 'wayland' 'libglvnd')
optdepends=('vulkan-icd-loader: Vulkan renderer')
provides=('vano')
conflicts=('vano')
source=("vano-$pkgver-linux-x86_64.tar.gz::https://github.com/tanisperez/vano/releases/download/v$pkgver/vano-$pkgver-linux-x86_64.tar.gz")
sha256sums=('SKIP')

package() {
    cd "vano-$pkgver-linux-x86_64"
    install -Dm755 bin/vano "$pkgdir/usr/bin/vano"
    cp -r share "$pkgdir/usr/share"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE"
}
