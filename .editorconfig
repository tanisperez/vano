[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[Makefile]
indent_style = tab

# An empty form or query value is written as "key = " by the serializer, trailing space included.
[samples/workspace/**.postino]
trim_trailing_whitespace = false
